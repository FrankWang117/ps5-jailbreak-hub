{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@ps5/core#build": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@ps5/data#build": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  },
  "globalDependencies": [".env", ".env.*"],
  "globalEnv": ["VITE_BASE_PATH", "VITE_SITE_URL"]
}
